<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activities.admin.TaskDetailsActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btPrevious"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:background="@drawable/button_shape"
            android:src="@drawable/arrow_left"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            style="@style/BaseText.subHeaderTextView"
            tools:text="Заголовок задачи..."
            android:textStyle="italic"
            android:gravity="center_vertical"

            app:layout_constraintEnd_toStartOf="@+id/btNext"
            app:layout_constraintStart_toEndOf="@+id/btPrevious"
            app:layout_constraintTop_toTopOf="parent"
            />
        <ImageButton
            android:id="@+id/btNext"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:background="@drawable/button_shape"
            android:src="@drawable/arrow_right"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/fields_group_shape"

        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <TextView
            android:id="@+id/tvOwnerTitle"
            style="@style/BaseText.fieldTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Владелец"
            android:textAlignment="center"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvOwner"
            style="@style/BaseText.fieldTitle.fieldValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/field_shape"
            android:padding="8dp"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOwnerTitle"
            tools:text="SANYA" />

        <TextView
            android:id="@+id/tvStatusTitle"
            style="@style/BaseText.fieldTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Статус"
            android:textAlignment="center"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOwner" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/BaseText.fieldTitle.fieldValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/field_shape"
            android:padding="8dp"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStatusTitle"
            tools:text="GOTOVO))" />

        <TextView
            android:id="@+id/tvScopeTitle"
            style="@style/BaseText.fieldTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Зона ответственности"
            android:textAlignment="center"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStatus" />

        <TextView
            android:id="@+id/tvScope"
            style="@style/BaseText.fieldTitle.fieldValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/field_shape"
            android:padding="8dp"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvScopeTitle"
            tools:text="GOVNO=)" />

        <TextView
            android:id="@+id/tvDeadlineTitle"
            style="@style/BaseText.fieldTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Дней осталось:"
            android:textAlignment="center"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvScope" />

        <TextView
            android:id="@+id/tvDeadline"
            style="@style/BaseText.fieldTitle.fieldValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/field_shape"
            android:padding="8dp"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDeadlineTitle"
            tools:text="VCHERA YOPTA))" />
        <TextView
            android:id="@+id/tvUserTakedTitle"
            style="@style/BaseText.fieldTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Задачу взял:"
            android:textAlignment="center"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDeadline" />

        <TextView
            android:id="@+id/tvUserTaked"
            style="@style/BaseText.fieldTitle.fieldValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/field_shape"
            android:padding="8dp"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvUserTakedTitle"
            tools:text="vasya))" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvSince"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Задача создана 27.8.2023"
        android:textSize="16sp"
        android:layout_marginTop="10dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout" />

    <Button
        android:id="@+id/btAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/BaseText.BaseButton"
        android:layout_marginHorizontal="40dp"
        android:layout_marginVertical="10dp"
        android:padding="0dp"
        tools:text="@string/takeTask"

        app:layout_constraintBottom_toTopOf="@id/btBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <Button
        android:id="@+id/btBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/BaseText.BaseButton"
        android:layout_marginHorizontal="40dp"
        android:layout_marginVertical="10dp"
        android:padding="0dp"
        android:text="@string/back"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>